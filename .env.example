# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/lms_dev"
DIRECT_URL="postgresql://postgres:password@localhost:5432/lms_dev"

# Public app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# JWT
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Telegram auth
TELEGRAM_BOT_TOKEN="replace-with-your-telegram-bot-token"
TELEGRAM_BOT_USERNAME="replace-with-your-bot-username"

# Storage
USE_SUPABASE_STORAGE="false"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-your-supabase-anon-key"

# AI indexing
GEMINI_API_KEY="replace-with-your-gemini-api-key"
CATALOGUE_GEMINI_MODEL="gemini-2.5-flash"
CATALOGUE_EMBEDDING_MODEL="Xenova/all-MiniLM-L6-v2"

# Cron auth
CRON_SECRET="replace-with-a-shared-secret-for-vercel-cron"
